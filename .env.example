# ─── ProxiSpeak .env.example ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All variables listed in docs/PROJECT_SPEC.md §10.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Docker Compose defaults (proxispeak_dev database)
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak_dev
# Test database (used by automated tests only)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/proxispeak_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── Multi-instance identity ──────────────────────────────────────────────────
# Unique per server container (e.g. server1, server2)
INSTANCE_ID=server1

# ─── WebRTC ICE ───────────────────────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=proxispeak
TURN_CREDENTIAL=replace_with_turn_credential

# ─── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Client (Vite env prefix) ─────────────────────────────────────────────────
VITE_SERVER_URL=http://localhost:3000

# ─── Seed script (dev only) ───────────────────────────────────────────────────
# Password used for all seeded users (alice, bob, carol, dave)
SEED_USER_PASSWORD=DevPassword123!
